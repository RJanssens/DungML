include "core.dmap"  # built-in feature library (pillar, chest, stairs, …)

# Miller's Cottage — exercises a building-style map: adjacent rooms,
# doorways (arches), windows on exterior walls, furniture features.

map "Miller's Cottage" {
  grid {
    cell   32 px
    units  feet 5
    bounds 30 x 20
  }
  renderer "floorplan"
  description """
  The miller's cottage sits beside the wheel-race, smelling of bread
  and woodsmoke. The door is on the latch but not barred.
  """
  dm_notes """
  Miller is at the mill (50 ft west, not drawn). His daughter hides
  in the bedroom (DC 15 Perception from the doorway to find her
  under the bed).
  """
}

room "kitchen" {
  rect 2,2 8 x 7
  label "Kitchen" align top center
  description "Flour on every surface."

  feature hearth at 9,4 rotate 90
  feature stove  at 3,3
  feature table  at 6,6 {
    description "Flour-dusted oak slab."
  }
  feature chair at 5,6
  feature chair at 7,6
}

room "parlor" {
  rect 10,2 10 x 7              # shares west wall with kitchen
  label "Parlor" at 15,5 size 1.1                       # absolute, slightly larger

  feature hearth     at 19,4 rotate -90
  feature chair      at 13,5
  feature chair      at 15,5
  feature bookshelf  at 11,3 rotate 90
}

room "bedroom" {
  rect 2,9 8 x 6                # shares north wall with kitchen
  label "Bedroom" align bottom center

  feature bed  at 3,10
  feature desk at 8,13
}

# Interior doorways (no leaf, just an opening)
door at 10,5 {
  connects room.kitchen, room.parlor
  type arch
}

door at 6,9 {
  connects room.kitchen, room.bedroom
  type arch
}

# Front door — single-side connect (other side is exterior)
door at 15,2 {
  connects room.parlor
  type wooden
  state closed
  facing south
  dm_notes "On the latch, not barred. Opens silently — recently oiled."
}

# Windows on exterior walls
window at 4,2  { in room.kitchen  width 1 }
window at 17,2 { in room.parlor   width 1.5 }
window at 5,15 { in room.bedroom  width 1 }
