# Plant — a single notable plant (a carnivorous pod, a shrieker).
feature_def "plant" {
  glyph {
    line stroke from 0,0.35 to 0,-0.05
    path fill "M0,-0.05 Q-0.3,-0.1 -0.25,-0.35 Q0,-0.25 0,-0.05 Z"
