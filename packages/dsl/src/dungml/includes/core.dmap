    circle stroke at 0,0 radius 0.35
    line stroke from 0,-0.3 to 0,0.05
    path fill "M-0.2,0.05 Q0,0.3 0.2,0.05 Z"
  }
}

# Crushing trap — walls or ceiling closing in: two arrows meeting on a bar.
