# Crystal — a faceted crystal or gem cluster.
feature_def "crystal" {
  glyph {
    polygon stroke (0,-0.38) (0.2,-0.1) (0.12,0.3) (-0.12,0.3) (-0.2,-0.1)
    line stroke from 0,-0.38 to 0,0.3
    line stroke from -0.2,-0.1 to 0.2,-0.1
  }
}

# Teleport pad — a marked disc that sends whoever stands on it elsewhere
