  secret
  glyph {
    circle stroke at 0,0 radius 0.35
    line stroke from -0.2,0 to 0.2,0
    polygon fill (-0.08,-0.28) (0.08,-0.28) (0,-0.08)
    polygon fill (-0.08,0.28) (0.08,0.28) (0,0.08)
  }
}

# Falling-block trap — a ceiling collapse or deadfall: a block over a line.
feature_def "falling-block-trap" {
  secret
  glyph {
    circle stroke at 0,0 radius 0.35
    rect fill at -0.12,-0.24 0.24 x 0.16
    line stroke from 0,-0.02 to 0,0.1
    line stroke from -0.22,0.18 to 0.22,0.18
