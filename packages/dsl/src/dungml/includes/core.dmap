feature_def "teleport-pad" {
  glyph {
    circle stroke at 0,0 radius 0.38
    circle stroke at 0,0 radius 0.22
    circle fill at 0,0 radius 0.07
  }
}

# Spout — a pipe mouth in the wall that pours water (or worse).
