# Direction sign — a post with a pointing board. Not `signpost`: city.dmap
# already has a coloured one, and the first include wins on a name clash.
feature_def "direction-sign" {
  glyph {
    line stroke from 0,0.4 to 0,-0.3
    polygon fill (-0.38,-0.22) (-0.2,-0.38) (0.3,-0.38) (0.3,-0.06) (-0.2,-0.06)
