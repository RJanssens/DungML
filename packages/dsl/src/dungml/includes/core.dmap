  secret
  glyph {
    circle stroke at 0,0 radius 0.35
    line stroke from -0.25,0.12 to 0.22,-0.12
    polygon fill (0.26,-0.14) (0.1,-0.14) (0.18,-0.02)
    line stroke from -0.25,0.12 to -0.3,0.02
    line stroke from -0.25,0.12 to -0.2,0.22
  }
}

# Blade trap — a swinging blade (pendulum, guillotine, scything wall).
