# dungml web (Vite). Defaults run in dev mode (static dev-user token, no Keycloak).
VITE_AUTH_MODE=dev
# Set keycloak + the vars below to use the shared realm (account reuse with ttrpg3):
# VITE_AUTH_MODE=keycloak
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=dungeon-daemon
# VITE_KEYCLOAK_CLIENT_ID=dungml-web
# VITE_APP_ORIGIN=http://localhost:5173
